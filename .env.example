# ── Build-time (baked into HTML by astro build) ───────────────────────────────
# In CI these are passed via GitHub Actions secrets.
# In local dev set them here.

# Stripe publishable key — controls whether the tip/support button renders
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PostHog analytics
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Whether to include draft posts in the build (set to "true" for local dev)
SHOW_DRAFTS=true

# ── GitHub (private content submodule) ────────────────────────────────────────
# Fine-grained PAT with read-only Contents access to sourcier/web-sourcier.uk-content
# https://github.com/settings/tokens?type=beta
GITHUB_PAT=

# ── Comment approval system ───────────────────────────────────────────────────
# Personal access token — https://app.netlify.com/user/applications
# NOTE: do NOT name it NETLIFY_ACCESS_TOKEN — Netlify auto-injects that name at runtime
# with a limited site-scoped machine token, overwriting your value and causing 401 errors.
NETLIFY_PAT=

# Form ID for the "blog-comments" (pending) form.
# Visible in the Netlify Forms dashboard URL.
COMMENTS_FORM_ID=

# Form ID for the "approved-comments" form.
# Visible in the Netlify Forms dashboard URL after the first comment is approved.
APPROVED_COMMENTS_FORM_ID=

# Random secret for HMAC-signing approve/delete links.
# Generate with: openssl rand -hex 32
APPROVAL_SECRET=

# Public URL of the site, e.g. https://sourcier.uk
SITE_URL=

# Secret key from Stripe — used by the Netlify function that creates embedded
# Checkout Sessions for the support checkout modal
STRIPE_SECRET_KEY=

# ── Resend (email) ────────────────────────────────────────────────────────────
# Resend API key — https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=

# Resend segment ID for broadcast emails (Audiences → Segments in the dashboard)
RESEND_SEGMENT_ID=
RESEND_TOPIC_ID=           # Optional — scopes broadcasts to a topic (e.g. "New Posts")

# Published Resend template ID for the welcome email.
# Run: node scripts/create-welcome-template.js to create and publish it.
RESEND_WELCOME_TEMPLATE_ID=

# Verified Resend sender address, e.g. hello@sourcier.uk
NOTIFY_FROM_EMAIL=

# Address to receive comment notification emails
NOTIFY_EMAIL=

# ── Dev.to cross-posting ──────────────────────────────────────────────────────
# API key from https://dev.to/settings/extensions → DEV Community API Keys
# Used by: node scripts/crosspost-devto.js  (or: pnpm crosspost:devto)
DEVTO_API_KEY=

# ── Netlify Blobs (post reactions) ────────────────────────────────────────────
# Required for LOCAL dev only (automatically available in production)
# Requires NETLIFY_SITE_ID plus either NETLIFY_AUTH_TOKEN or NETLIFY_PAT
# Optional local Blobs token — https://app.netlify.com/user/applications
# Leave NETLIFY_AUTH_TOKEN empty to reuse NETLIFY_PAT
# Site ID — visible in Site configuration → General → Site ID
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
