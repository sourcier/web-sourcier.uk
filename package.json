{
  "name": "web-sourcier-uk",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf .astro dist public/pagefind .playwright-mcp",
    "dev": "pnpm thumbnails:copy && pnpm post-images:copy && SHOW_DRAFTS=true netlify dev",
    "dev:no-drafts": "pnpm thumbnails:copy && pnpm post-images:copy && netlify dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,cts,astro}\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "astro": "astro",
    "thumbnails:generate": "node scripts/process-thumbnails.mjs",
    "thumbnails:copy": "node scripts/copy-thumbnails.mjs",
    "post-images:copy": "node scripts/copy-post-images.mjs",
    "search:index": "pnpm thumbnails:copy && pnpm post-images:copy && SHOW_DRAFTS=true astro build && pagefind --site dist && rm -rf public/pagefind && cp -r dist/pagefind public/pagefind",
    "crosspost:prepare": "node scripts/prepare-crosspost.js",
    "crosspost:devto": "node scripts/crosspost-devto.js",
    "template:pptx": "node scripts/create-powerpoint-template.mjs",
    "talk:playwright": "node scripts/create-playwright-e2e-talk.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/rss": "^4.0.18",
    "@expressive-code/plugin-line-numbers": "^0.41.7",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@netlify/blobs": "^10.7.4",
    "astro": "^6.1.1",
    "astro-expressive-code": "^0.41.7",
    "bulma": "^1.0.4",
    "mermaid": "^11.13.0",
    "reading-time": "^1.5.0",
    "sass": "^1.98.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/edge-functions": "^3.0.6",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pagefind": "^1.4.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "remark-emoji": "^5.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
