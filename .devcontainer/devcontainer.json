{
  "name": "sourcier.uk",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.33.2 --activate && pnpm install && pnpm exec playwright install --with-deps chromium && npm install -g netlify-cli",

  "forwardPorts": [4321, 8888],
  "portsAttributes": {
    "4321": {
      "label": "Astro Dev Server",
      "onAutoForward": "notify"
    },
    "8888": {
      "label": "Netlify Dev",
      "onAutoForward": "openBrowser"
    }
  },

  "remoteEnv": {
    "SHOW_DRAFTS": "true",
    "GITHUB_PAT": "${localEnv:GH_PAT}"
  },

  "secrets": {
    "GH_PAT": {
      "description": "GitHub PAT with read access to sourcier/sourcier.uk-content. Required for pnpm build:content:fetch.",
      "documentationUrl": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-playwright.playwright"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[astro]": {
          "editor.defaultFormatter": "astro-build.astro-vscode"
        },
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
