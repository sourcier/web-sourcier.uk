{
  "name": "sourcier.uk",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "runArgs": ["--env-file", ".env"],

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // onCreateCommand runs once at prebuild time — baked into the Codespaces snapshot.
  //
  // Deno setup — why it's done this way:
  //   Netlify CLI uses @netlify/edge-bundler to run edge functions, which requires Deno.
  //   edge-bundler downloads Deno itself into ~/.config/netlify/deno-cli/ and checks a
  //   version.txt file in that directory before deciding whether to re-download.
  //   If version.txt is missing or doesn't satisfy DENO_VERSION_RANGE, it downloads fresh —
  //   and that download is always x86-64, which crashes on arm64 (Apple Silicon) with:
  //     "rosetta error: failed to open elf at /lib64/ld-linux-x86-64.so.2"
  //
  //   The fix: install Deno via the official installer (which detects arch correctly),
  //   copy the binary to the edge-bundler cache path, and write version.txt so
  //   getCachedBinary() in bridge.js accepts it and skips the download entirely.
  //
  //   Deno is installed here (not in the Dockerfile) so the installer runs inside the
  //   live container and detects the correct architecture (arm64 vs x86-64).
  //   Installing in the Dockerfile runs under emulation and always produces an x86-64 binary.
  //
  //   The version (2.4.2) is the floor of DENO_VERSION_RANGE = '^2.4.2' defined in:
  //     node_modules/@netlify/edge-bundler/dist/node/bridge.js
  //   If Netlify CLI upgrades this range, bump the version here and in version.txt to match.
  //
  //   The -y flag suppresses the "Edit shell configs to add deno to the PATH?" prompt
  //   (added in github.com/denoland/deno/issues/25931). --no-modify-path skips PATH edits.
  //
  // pnpm install must precede playwright install so the binary resolves correctly.
  "onCreateCommand": "curl -fsSL https://deno.land/install.sh | sh -s -- v2.4.2 -y --no-modify-path && mkdir -p /home/node/.config/netlify/deno-cli && cp /home/node/.deno/bin/deno /home/node/.config/netlify/deno-cli/deno && echo '2.4.2' > /home/node/.config/netlify/deno-cli/version.txt && pnpm install && pnpm exec playwright install chromium",
  // updateContentCommand re-runs on every new codespace (picks up lockfile changes).
  // Chromium is already present from the prebuild snapshot so no reinstall needed.
  "updateContentCommand": "pnpm install",

  // Explicit mounts for agent safety — only the project workspace is writable.
  // SSH keys are read-only so git push works but the agent can't modify them.
  // Note: these mounts are local Docker only — Codespaces ignores runArgs and
  // handles SSH/git auth natively, so missing host paths would cause startup failure.
  // Guard with initializeCommand or accept that Codespaces users need SSH set up separately.
  "initializeCommand": "test -n \"$CODESPACES\" || (mkdir -p ~/.ssh ~/.oh-my-zsh/custom && touch ~/.gitconfig ~/.zshrc ~/.zsh ~/.aliases ~/.p10k.zsh ~/.zsh_history); test -f .env || touch .env",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/node/.gitconfig,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.zshrc,target=/home/node/.zshrc,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.zsh,target=/home/node/.zsh,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.aliases,target=/home/node/.aliases,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.p10k.zsh,target=/home/node/.p10k.zsh,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.oh-my-zsh/custom,target=/home/node/.oh-my-zsh/custom,type=bind,consistency=cached,readonly",
    "source=${localEnv:HOME}/.zsh_history,target=/home/node/.zsh_history,type=bind,consistency=cached",
    "source=playwright-cache,target=/home/node/.cache/ms-playwright,type=volume"
  ],

  "forwardPorts": [8888, 4321],
  "portsAttributes": {
    "8888": {
      "label": "Netlify Dev",
      "onAutoForward": "silent"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },

  "remoteEnv": {
    "SHOW_DRAFTS": "true"
  },

  "secrets": {
    "GH_PAT": {
      "description": "Fine-grained GitHub PAT with read access to sourcier/sourcier.uk-content and the 'Copilot Requests' permission. Used for content fetching and Copilot CLI authentication.",
      "documentationUrl": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens"
    },
    "NETLIFY_AUTH_TOKEN": {
      "description": "Netlify personal access token. Required for netlify dev and netlify CLI commands.",
      "documentationUrl": "https://app.netlify.com/user/applications"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-playwright.playwright",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[astro]": {
          "editor.defaultFormatter": "astro-build.astro-vscode"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "remote.autoForwardPortsSource": "output"
      }
    }
  }
}
