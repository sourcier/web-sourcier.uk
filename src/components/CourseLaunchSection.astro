---

---

<section
  class="course-launch stack-space"
  id="course-launch"
  aria-labelledby="course-launch-heading"
>
  <div class="container is-max-desktop">
    <p
      class="section-label section-label--secondary course-launch__section-label"
    >
      Courses
    </p>
    <div class="course-launch__card">
      <div class="course-launch__intro">
        <p class="course-launch__status">Launching soon</p>
        <p class="course-launch__kicker">
          For career switchers and engineers building confidence
        </p>
        <h2 class="course-launch__heading" id="course-launch-heading">
          Full Stack Developer Course
        </h2>
        <p class="course-launch__body">
          A practical learning path for people moving into tech and engineers
          who want stronger full-stack foundations. First cohort details are
          coming soon.
        </p>
      </div>

      <ul
        class="course-launch__modules"
        role="list"
        aria-label="Course modules"
      >
        <li class="course-launch__module">
          <p class="course-launch__module-title">Web foundations</p>
          <p class="course-launch__module-copy">
            Semantic HTML, modern CSS, accessibility, and the layout patterns
            you actually use on real projects.
          </p>
        </li>
        <li class="course-launch__module">
          <p class="course-launch__module-title">JavaScript across the stack</p>
          <p class="course-launch__module-copy">
            Build front-end features, design APIs, and understand how full-stack
            applications fit together.
          </p>
        </li>
        <li class="course-launch__module">
          <p class="course-launch__module-title">Shipping and team habits</p>
          <p class="course-launch__module-copy">
            Testing, deployments, debugging, and the engineering habits that
            help you work confidently in a team.
          </p>
        </li>
      </ul>

      <form
        class="course-launch__form"
        id="course-launch-form"
        novalidate
        aria-label="Register interest for full stack course"
      >
        <p class="course-launch__fineprint">
          No spam. Course updates and early access only.
        </p>
        <p class="course-launch__honeypot" aria-hidden="true">
          <label for="course-launch-website">Leave this blank</label>
          <input
            id="course-launch-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </p>
        <div class="course-launch__field">
          <label for="course-launch-email" class="is-sr-only"
            >Email address</label
          >
          <input
            id="course-launch-email"
            name="email"
            type="email"
            class="input course-launch__input"
            placeholder="your@email.com"
            autocomplete="email"
            required
          />
          <button type="submit" class="button course-launch__btn is-ink">
            Get course updates
          </button>
        </div>
        <p
          class="course-launch__feedback"
          id="course-launch-feedback"
          aria-live="polite"
          hidden
        >
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById(
    "course-launch-form",
  ) as HTMLFormElement | null;
  const feedback = document.getElementById(
    "course-launch-feedback",
  ) as HTMLElement | null;
  const input = document.getElementById(
    "course-launch-email",
  ) as HTMLInputElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!input || !feedback) return;

    const email = input.value.trim();
    if (!email) return;

    const button = form.querySelector(
      "button[type=submit]",
    ) as HTMLButtonElement | null;
    if (!button) return;

    button.disabled = true;
    button.textContent = "Registering…";
    feedback.hidden = true;
    feedback.className = "course-launch__feedback";

    try {
      const response = await fetch("/.netlify/functions/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email,
          website:
            (form.elements.namedItem("website") as HTMLInputElement)?.value ??
            "",
          source: "full-stack-course",
        }),
      });

      const data = await response.json();

      if (response.ok) {
        feedback.textContent =
          "You're on the list. I'll email you when enrolment opens.";
        feedback.classList.add("course-launch__feedback--success");
        form.reset();
        button.textContent = "Registered";
      } else {
        feedback.textContent =
          data.error ?? "Something went wrong. Please try again.";
        feedback.classList.add("course-launch__feedback--error");
        button.disabled = false;
        button.textContent = "Get course updates";
      }
    } catch {
      feedback.textContent = "Something went wrong. Please try again.";
      feedback.classList.add("course-launch__feedback--error");
      button.disabled = false;
      button.textContent = "Get course updates";
    } finally {
      feedback.hidden = false;
    }
  });
</script>

<style lang="scss">
  .course-launch {
    padding: 0 1.5rem;
  }

  .course-launch__section-label {
    margin-bottom: 1.5rem;
  }

  .course-launch__card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-top: 4px solid var(--accent-secondary);
    border-radius: var(--radius-panel);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--accent-secondary) 10%, var(--surface-elevated))
          0%,
        var(--surface-elevated) 38%
      ),
      var(--surface-elevated);
    box-shadow: var(--shadow-panel);

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(
        ellipse 80% 80% at 100% 0%,
        color-mix(in srgb, var(--accent-secondary) 10%, transparent) 0%,
        transparent 58%
      );
      pointer-events: none;
    }
  }

  .course-launch__intro {
    margin-bottom: 1rem;
  }

  .course-launch__status {
    display: inline-flex;
    align-items: center;
    margin: 0 0 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-strong);
    background: var(--accent-secondary);
    box-shadow: 0 10px 24px
      color-mix(in srgb, var(--accent-secondary) 24%, transparent);
  }

  .course-launch__kicker {
    margin: 0 0 0.35rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-secondary);
  }

  .course-launch__heading {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1;
    color: var(--text-primary);
  }

  .course-launch__body {
    margin: 0.65rem 0 0;
    color: var(--text-muted);
    max-width: 60ch;
  }

  .course-launch__modules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  .course-launch__module {
    border: 1px solid color-mix(in srgb, var(--border-subtle) 75%, transparent);
    border-radius: var(--radius-compact);
    padding: 0.85rem 0.9rem;
    background: color-mix(
      in srgb,
      var(--surface-page) 88%,
      var(--accent-secondary) 12%
    );
    animation: course-module-in 320ms ease both;

    &:nth-child(2) {
      animation-delay: 80ms;
    }

    &:nth-child(3) {
      animation-delay: 160ms;
    }
  }

  .course-launch__module-title {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
    font-weight: 700;
  }

  .course-launch__module-copy {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .course-launch__form {
    margin-top: 1rem;
  }

  .course-launch__fineprint {
    margin: 0 0 0.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .course-launch__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .course-launch__input {
    min-height: 2.75rem;
    border-radius: var(--radius-tight);
    border: 1px solid var(--border-subtle);
    background: var(--surface-page);
    color: var(--text-primary);

    &:focus {
      border-color: var(--accent-secondary);
      box-shadow: 0 0 0 2px
        color-mix(in srgb, var(--accent-secondary) 20%, transparent);
      outline: none;
    }
  }

  .course-launch__btn {
    min-height: 2.75rem;
    letter-spacing: 0.04em;

    &:disabled {
      opacity: 0.75;
      cursor: not-allowed;
    }
  }

  .course-launch__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .course-launch__feedback {
    margin-top: 0.6rem;
    font-size: 0.875rem;

    &--success {
      color: var(--color-success);
    }

    &--error {
      color: var(--color-danger);
    }
  }

  @keyframes course-module-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 768px) {
    .course-launch__modules {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .course-launch__field {
      align-items: stretch;
      flex-direction: row;
    }

    .course-launch__btn {
      min-width: 13.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .course-launch__module {
      animation: none;
    }
  }
</style>
