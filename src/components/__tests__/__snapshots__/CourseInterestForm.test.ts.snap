// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CourseInterestForm > renders stacked layout 1`] = `"<form class="course-interest-form course-interest-form--stacked" id="course-interest-form" novalidate aria-label="Register interest for courses" data-email-id="course-interest-email" data-source="course-interest" data-success="You're on the list. I'll email you when enrolment opens." data-button-label="Get course updates"> <p class="course-interest-form__fineprint">No spam. Course updates and early access only.</p> <p class="course-interest-form__honeypot" aria-hidden="true"> <label for="course-interest-website">Leave this blank</label> <input id="course-interest-website" name="website" type="text" tabindex="-1" autocomplete="off"> </p> <div class="course-interest-form__field"> <label for="course-interest-email" class="visually-hidden">Email address</label> <input id="course-interest-email" name="email" type="email" class="course-interest-form__input" placeholder="your@email.com" autocomplete="email" required> <button type="submit" class="button course-interest-form__btn is-ink is-medium"> Get course updates </button> </div> <p class="course-interest-form__feedback" id="course-interest-feedback" aria-live="polite" hidden></p> </form>"`;

exports[`CourseInterestForm > renders with default props 1`] = `"<form class="course-interest-form" id="course-interest-form" novalidate aria-label="Register interest for courses" data-email-id="course-interest-email" data-source="course-interest" data-success="You're on the list. I'll email you when enrolment opens." data-button-label="Get course updates"> <p class="course-interest-form__fineprint">No spam. Course updates and early access only.</p> <p class="course-interest-form__honeypot" aria-hidden="true"> <label for="course-interest-website">Leave this blank</label> <input id="course-interest-website" name="website" type="text" tabindex="-1" autocomplete="off"> </p> <div class="course-interest-form__field"> <label for="course-interest-email" class="visually-hidden">Email address</label> <input id="course-interest-email" name="email" type="email" class="course-interest-form__input" placeholder="your@email.com" autocomplete="email" required> <button type="submit" class="button course-interest-form__btn is-ink is-medium"> Get course updates </button> </div> <p class="course-interest-form__feedback" id="course-interest-feedback" aria-live="polite" hidden></p> </form>"`;
