---

---

<section class="mailing-cta stack-space stack-space--tight">
  <div class="container is-max-desktop">
    <div class="mailing-cta__card" aria-labelledby="mailing-cta-heading">
      <div class="mailing-cta__inner">
        <div class="mailing-cta__copy">
          <p class="mailing-cta__kicker">
            Free · Practical · One email per post
          </p>
          <h2 class="mailing-cta__heading" id="mailing-cta-heading">
            Get practical engineering notes
          </h2>
          <p class="mailing-cta__body">
            One short email when a new article goes live. Useful if you are
            breaking into tech, growing as an engineer, or improving engineering
            practice on your team.
          </p>
        </div>

        <form
          class="mailing-cta__form"
          id="mailing-cta-form"
          novalidate
          aria-label="Newsletter sign up"
        >
          <p class="mailing-cta__honeypot" aria-hidden="true">
            <label for="mailing-cta-website">Leave this blank</label>
            <input
              id="mailing-cta-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </p>
          <div class="mailing-cta__field">
            <label for="mailing-cta-email" class="is-sr-only"
              >Email address</label
            >
            <input
              id="mailing-cta-email"
              name="email"
              type="email"
              class="input mailing-cta__input"
              placeholder="your@email.com"
              autocomplete="email"
              required
            />
            <button type="submit" class="button mailing-cta__btn">
              Join the list
            </button>
          </div>
          <p
            class="mailing-cta__feedback"
            id="mailing-cta-feedback"
            aria-live="polite"
            hidden
          >
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById(
    "mailing-cta-form",
  ) as HTMLFormElement | null;
  const feedback = document.getElementById(
    "mailing-cta-feedback",
  ) as HTMLElement | null;
  const input = document.getElementById(
    "mailing-cta-email",
  ) as HTMLInputElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!input || !feedback) return;

    const email = input.value.trim();
    if (!email) return;

    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Subscribing…";

    feedback.hidden = true;
    feedback.className = "mailing-cta__feedback";

    try {
      const res = await fetch("/.netlify/functions/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email,
          website:
            (form.elements.namedItem("website") as HTMLInputElement)?.value ??
            "",
        }),
      });

      const data = await res.json();

      if (res.ok) {
        feedback.textContent =
          "You're subscribed! Check your inbox for a confirmation.";
        feedback.classList.add("mailing-cta__feedback--success");
        form.reset();
        btn.textContent = "You're in";
        btn.disabled = true;
      } else {
        feedback.textContent =
          data.error ?? "Something went wrong. Please try again.";
        feedback.classList.add("mailing-cta__feedback--error");
        btn.disabled = false;
        btn.textContent = "Join the list";
      }
    } catch {
      feedback.textContent = "Something went wrong. Please try again.";
      feedback.classList.add("mailing-cta__feedback--error");
      btn.disabled = false;
      btn.textContent = "Join the list";
    } finally {
      feedback.hidden = false;
    }
  });
</script>

<style lang="scss">
  .mailing-cta {
    padding: 0 1.5rem 3rem;
  }

  .mailing-cta__card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-panel);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-top: 3px solid var(--color-secondary);
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background:
      radial-gradient(
        ellipse 95% 85% at 100% 0%,
        color-mix(in srgb, var(--color-secondary) 42%, transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 70% 60% at 0% 0%,
        rgba(232, 0, 106, 0.08) 0%,
        transparent 52%
      ),
      linear-gradient(180deg, #121714 0%, #09100d 100%);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.24);

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        circle,
        rgba(255, 255, 255, 0.12) 1px,
        transparent 1px
      );
      background-size: 28px 28px;
      mask-image: radial-gradient(
        ellipse 90% 90% at 50% 50%,
        black 30%,
        transparent 90%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 90% 90% at 50% 50%,
        black 30%,
        transparent 90%
      );
      opacity: 0.3;
      pointer-events: none;
    }
  }

  .mailing-cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;

    @media (min-width: 768px) {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }
  }

  .mailing-cta__copy {
    flex: 1;
    max-width: 40rem;
  }

  .mailing-cta__kicker {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-secondary) 72%, #ffffff 28%);
    margin-bottom: 0.4rem;
  }

  .mailing-cta__heading {
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .mailing-cta__body {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  .mailing-cta__form {
    flex-shrink: 0;
    width: 100%;
    padding: 1rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);

    @media (min-width: 768px) {
      width: 22rem;
    }
  }

  .mailing-cta__field {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    @media (min-width: 640px) {
      flex-direction: row;
    }
  }

  .mailing-cta__input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    height: 3rem;
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border-radius: 4px;

    &::placeholder {
      color: rgba(255, 255, 255, 0.35);
    }

    &:focus {
      border-color: var(--color-secondary);
      box-shadow: 0 0 0 2px
        color-mix(in srgb, var(--color-secondary) 24%, transparent);
      outline: none;
    }
  }

  .mailing-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    border-color: rgba(255, 255, 255, 0.92);
    color: var(--color-secondary-deep);
    font-weight: 600;
    white-space: nowrap;
    min-height: 3rem;
    height: 3rem;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.24);

    &:hover:not(:disabled) {
      background-color: color-mix(
        in srgb,
        #ffffff 92%,
        var(--color-secondary) 8%
      );
      border-color: color-mix(in srgb, #ffffff 92%, var(--color-secondary) 8%);
      color: var(--color-secondary-deep);
    }

    &:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }
  }

  .mailing-cta__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .mailing-cta__feedback {
    margin-top: 0.625rem;
    font-size: 0.875rem;

    &--success {
      color: #4ade80;
    }

    &--error {
      color: #f87171;
    }
  }
</style>
