---
import type { CollectionEntry } from "astro:content";
import BlogPost from "./BlogPost.astro";
import readingTime from "reading-time";

interface Props {
  posts: CollectionEntry<"posts">[];
  currentPage: number;
  totalPages: number;
  prevUrl: string | null;
  nextUrl: string | null;
  paginationBase?: string;
  sectionLabel?: string;
  sectionTitle?: string;
  sectionDescription?: string;
}

const { posts, currentPage, totalPages, prevUrl, nextUrl, paginationBase } =
  Astro.props;

const COLS = 3;
const placeholderCount =
  currentPage === totalPages ? (COLS - (posts.length % COLS)) % COLS : 0;

function pageUrl(n: number) {
  if (paginationBase) {
    return n === 1 ? paginationBase : `${paginationBase}/${n}`;
  }
  return n === 1 ? "/blog" : `/blog/page/${n}`;
}
---

<section class="section blog-grid-section">
  <div class="container is-max-desktop">
    {
      (Astro.props.sectionLabel || Astro.props.sectionTitle) && (
        <div class="blog-grid__header">
          {Astro.props.sectionLabel && (
            <p class="section-label">{Astro.props.sectionLabel}</p>
          )}
          {Astro.props.sectionTitle && (
            <h2 class="blog-grid__title">{Astro.props.sectionTitle}</h2>
          )}
          {Astro.props.sectionDescription && (
            <p class="blog-grid__description">
              {Astro.props.sectionDescription}
            </p>
          )}
        </div>
      )
    }
    <div
      class="fixed-grid has-1-cols-mobile has-2-cols-tablet has-3-cols-desktop"
    >
      <div class="grid">
        {
          posts.map((post) => (
            <div class="cell">
              <BlogPost
                title={post.data.title}
                subTitle={post.data.subTitle}
                description={post.data.description}
                url={`/blog/${post.id}`}
                cover={post.data.cover}
                pubDate={post.data.pubDate}
                draft={post.data.draft}
                readingTime={readingTime(post.body ?? "").text}
              />
            </div>
          ))
        }
        {
          Array.from({ length: placeholderCount }).map(() => (
            <div class="cell">
              <div
                class="card card__blog card__blog--placeholder"
                aria-hidden="true"
              >
                <div class="card__blog--placeholder-inner">
                  <span class="card__blog--placeholder-label">
                    More posts coming soon
                  </span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {
      totalPages > 1 && (
        <nav class="pagination-nav" aria-label="Blog pagination">
          <a
            href={prevUrl}
            class={`pagination-nav__btn${!prevUrl ? " pagination-nav__btn--disabled" : ""}`}
            aria-disabled={!prevUrl}
            tabindex={!prevUrl ? -1 : 0}
          >
            &larr; Previous
          </a>

          <div class="pagination-nav__pages" role="list">
            {Array.from({ length: totalPages }).map((_, i) => {
              const n = i + 1;
              return (
                <a
                  href={pageUrl(n)}
                  role="listitem"
                  class={`pagination-nav__page${n === currentPage ? " pagination-nav__page--active" : ""}`}
                  aria-current={n === currentPage ? "page" : undefined}
                >
                  {n}
                </a>
              );
            })}
          </div>

          <a
            href={nextUrl}
            class={`pagination-nav__btn${!nextUrl ? " pagination-nav__btn--disabled" : ""}`}
            aria-disabled={!nextUrl}
            tabindex={!nextUrl ? -1 : 0}
          >
            Next &rarr;
          </a>
        </nav>
      )
    }
  </div>
</section>

<style lang="scss">
  .blog-grid-section {
    padding-top: 2.75rem;
    padding-bottom: 0;
  }

  .blog-grid__header {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .blog-grid__title {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .blog-grid__description {
    margin: 0;
    max-width: 60ch;
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* ── Pagination ───────────────────────────────────────────── */
  .pagination-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background:
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--color-secondary) 10%, transparent) 0%,
        transparent 34%
      ),
      linear-gradient(
        150deg,
        color-mix(in srgb, var(--color-pink) 4%, var(--color-surface)) 0%,
        var(--color-surface) 58%
      ),
      var(--color-surface);
    box-shadow: var(--shadow-panel);
  }

  .pagination-nav__pages {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .pagination-nav__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.65rem;
    height: 2.65rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-border) 45%, transparent);
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;

    &:hover {
      background-color: color-mix(
        in srgb,
        var(--color-pink) 8%,
        var(--color-surface)
      );
      border-color: rgba(232, 0, 106, 0.2);
      transform: translateY(-1px);
    }

    &--active {
      background-color: var(--color-secondary);
      border-color: var(--color-secondary);
      color: #fff;
      box-shadow: 0 12px 24px rgba(41, 92, 69, 0.2);

      &:hover {
        background-color: var(--color-secondary);
        border-color: var(--color-secondary);
        transform: none;
      }
    }
  }

  .pagination-nav__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-surface);
    box-shadow: 0 10px 24px rgba(15, 15, 15, 0.04);
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;

    &:hover {
      color: var(--color-pink);
      border-color: rgba(232, 0, 106, 0.28);
      transform: translateY(-1px);
    }

    &--disabled {
      color: var(--color-muted);
      background-color: transparent;
      box-shadow: none;
      pointer-events: none;
    }
  }

  @media (max-width: 639px) {
    .pagination-nav {
      align-items: stretch;
    }

    .pagination-nav__pages {
      order: 3;
      width: 100%;
    }

    .pagination-nav__btn {
      flex: 1 1 10rem;
    }
  }

  /* ── Placeholder card ────────────────────────────────────── */
  .card__blog--placeholder {
    pointer-events: none;
    border: 2px dashed var(--color-border);
    border-top: 2px dashed rgba(41, 92, 69, 0.22);
    border-radius: var(--radius-panel);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--color-secondary) 4%, var(--color-surface)) 0%,
        transparent 62%
      ),
      transparent;
    box-shadow: none;

    &-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
      padding: 2rem 1.5rem;
    }

    &-label {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-muted);
    }
  }
</style>
