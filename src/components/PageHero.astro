---
import { tagSlug } from "../utils/tags";
import Breadcrumb from "./Breadcrumb.astro";
import SharePost from "./SharePost.astro";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  coverImage?: { src: string; alt?: string };
  tags?: string[];
  author?: string;
  date?: string;
  readingTime?: string;
  crumbs?: Crumb[];
  shareUrl?: string;
  shareTitle?: string;
}

const {
  kicker,
  title,
  subtitle,
  coverImage,
  tags,
  author,
  date,
  readingTime,
  crumbs,
  shareUrl,
  shareTitle,
} = Astro.props;

function autoCrumbs(path: string): Crumb[] {
  const segments = path.split("/").filter(Boolean);
  const meaningful = segments.filter((s) => s !== "page" && !/^\d+$/.test(s));
  return meaningful.map((seg, i) => ({
    label: seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
    href: "/" + meaningful.slice(0, i + 1).join("/"),
  }));
}

const resolvedCrumbs: Crumb[] = crumbs ?? autoCrumbs(Astro.url.pathname);
---

<header
  class="page-hero"
  style={coverImage ? `--cover-image: url('${coverImage.src}')` : ""}
  data-has-cover={coverImage ? "true" : "false"}
>
  <div class="container">
    <div class="page-hero__inner">
      {
        resolvedCrumbs.length > 0 && (
          <Breadcrumb crumbs={resolvedCrumbs} inverted />
        )
      }
      {kicker && <p class="hero-kicker">{kicker}</p>}
      <h1 class="page-hero__title">{title}</h1>
      {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
      {
        (author || date || readingTime || (tags && tags.length > 0)) && (
          <div class="page-hero__meta">
            {author && <span class="page-hero__author">By {author}</span>}
            {date && <span class="page-hero__date">{date}</span>}
            {readingTime && (
              <span class="page-hero__reading-time">{readingTime}</span>
            )}
            {(date || readingTime) && tags && tags.length > 0 && (
              <span class="page-hero__divider" aria-hidden="true" />
            )}
            {tags && tags.length > 0 && (
              <div class="page-hero__tags">
                {tags.map((tag: string) => (
                  <a href={`/tags/${tagSlug(tag)}`} class="page-hero__tag">
                    {tag}
                  </a>
                ))}
              </div>
            )}
          </div>
        )
      }
      {
        shareUrl && shareTitle && (
          <div class="page-hero__share">
            <SharePost url={shareUrl} title={shareTitle} />
          </div>
        )
      }
    </div>
  </div>
</header>

<script>
  const hero = document.querySelector<HTMLElement>(
    ".page-hero[data-has-cover='true']",
  );
  if (hero) {
    const update = () => {
      const offset = window.scrollY;
      // Move the background at 40% of scroll speed for a subtle parallax
      hero.style.backgroundPositionY = `calc(50% + ${offset * 0.4}px)`;
    };
    window.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>

<style lang="scss">
  .page-hero {
    min-height: 320px;
    display: flex;
    align-items: flex-end;
    padding: 5rem 1.5rem 4rem;
    background:
      radial-gradient(
        ellipse 80% 60% at 74% 0%,
        rgba(var(--accent-primary-rgb), 0.18) 0%,
        transparent 62%
      ),
      radial-gradient(
        ellipse 86% 74% at 12% 0%,
        color-mix(in srgb, var(--accent-secondary) 24%, transparent) 0%,
        transparent 62%
      ),
      var(--surface-strong-top);
    color: var(--text-on-strong);
    position: relative;
    isolation: isolate;
    overflow: hidden;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background-image: radial-gradient(
        circle,
        rgba(var(--text-on-strong-rgb), 0.18) 1px,
        transparent 1px
      );
      background-size: 28px 28px;
      mask-image: radial-gradient(
        ellipse 90% 90% at 50% 50%,
        black 30%,
        transparent 90%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 90% 90% at 50% 50%,
        black 30%,
        transparent 90%
      );
      pointer-events: none;

      @media (prefers-reduced-motion: no-preference) {
        animation: dot-grid-breathe 4s ease-in-out infinite;
      }
    }

    @keyframes dot-grid-breathe {
      0%,
      100% {
        opacity: 0.5;
      }
      50% {
        opacity: 1;
      }
    }

    &[data-has-cover="true"] {
      min-height: 420px;
      padding: 5rem 1.5rem 4rem;
      background-image: var(--cover-image);
      background-size: cover;
      background-position: center;

      &::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -2;
        background: linear-gradient(
          to bottom,
          rgba(var(--overlay-rgb), 0.35) 0%,
          rgba(var(--overlay-rgb), 0.7) 55%,
          rgba(var(--overlay-rgb), 0.92) 100%
        );
        pointer-events: none;
      }

      .page-hero__tag {
        background-color: rgba(var(--text-on-strong-rgb), 0.1);
        border-color: rgba(var(--text-on-strong-rgb), 0.25);
        color: rgba(var(--text-on-strong-rgb), 0.7);

        &:hover {
          background-color: rgba(var(--accent-primary-rgb), 0.12);
          border-color: rgba(var(--accent-primary-rgb), 0.5);
          color: var(--accent-primary);
        }
      }
    }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
    }
  }

  .page-hero__inner {
    max-width: 820px;
  }

  .page-hero__title {
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    color: var(--text-on-strong);
  }

  .page-hero__subtitle {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.65;
    color: rgba(var(--text-on-strong-rgb), 0.8);
    margin-bottom: 1.65rem;
    font-weight: 400;
  }

  .page-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    font-size: 0.875rem;
    font-family: "Barlow Condensed", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(var(--text-on-strong-rgb), 0.5);
  }

  .page-hero__author {
    color: rgba(var(--text-on-strong-rgb), 0.85);
  }

  .page-hero__date {
    &::before {
      content: "·";
      margin-right: 1rem;
      color: var(--accent-primary);
    }
  }

  .page-hero__divider {
    &::before {
      content: "·";
      color: var(--accent-primary);
    }

    @media (max-width: 639px) {
      display: none;
    }
  }

  .page-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .page-hero__tag {
    display: inline-block;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(var(--text-on-strong-rgb), 0.55);
    border: 1px solid rgba(var(--text-on-strong-rgb), 0.18);
    border-radius: var(--radius-tight);
    padding: 0.25rem 0.6rem;

    @media (max-width: 639px) {
      font-size: 0.8rem;
      padding: 0.4rem 0.75rem;
    }
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;

    &:hover {
      background-color: rgba(var(--accent-primary-rgb), 0.12);
      border-color: rgba(var(--accent-primary-rgb), 0.5);
      color: var(--accent-primary);
    }
  }

  .hero-kicker {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    margin-bottom: 0.75rem;
  }

  .page-hero__share {
    margin-top: 1.5rem;

    :global(.share-post) {
      border-color: rgba(var(--text-on-strong-rgb), 0.15);
      border-bottom: none;
      padding: 1.25rem 0 0;
      margin: 0;
    }

    :global(.share-post__label) {
      color: rgba(var(--text-on-strong-rgb), 0.4);
    }

    :global(.share-post__btn) {
      color: rgba(var(--text-on-strong-rgb), 0.55);
      border-color: rgba(var(--text-on-strong-rgb), 0.18);
      background-color: rgba(var(--text-on-strong-rgb), 0.06);

      &:hover {
        color: var(--accent-primary);
        border-color: rgba(var(--accent-primary-rgb), 0.5);
        background-color: rgba(var(--accent-primary-rgb), 0.12);
      }
    }
  }
</style>
