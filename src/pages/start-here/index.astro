---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import MailingListCTA from "../../components/MailingListCTA.astro";
import { audienceGuides } from "../../data/audienceGuides";
---

<BaseLayout
  pageTitle="Start Here — Sourcier"
  description="Choose a practical guide for transitioning into tech, growing as an engineer, or improving engineering practice on your team."
>
  <PageHero
    kicker="Start here"
    title="Choose the guide that matches where you are now"
    subtitle="Whether you are transitioning into tech, growing as an engineer, or improving engineering practice on a team, start with the guide that fits your situation."
  />

  <section
    class="section start-here-grid"
    aria-labelledby="start-here-grid-heading"
  >
    <div class="container is-max-desktop">
      <p class="section-label">Guides</p>
      <h2 class="start-here-grid__heading" id="start-here-grid-heading">
        Three practical routes into the site
      </h2>
      <div class="start-here-grid__cards">
        {
          audienceGuides.map((guide) => (
            <article class="start-here-card">
              <h3 class="start-here-card__title">{guide.title}</h3>
              <p class="start-here-card__body">{guide.summary}</p>
              <div class="start-here-card__meta" aria-label="Guide coverage">
                <span>{guide.currentPostIds.length} published now</span>
                <span>{guide.plannedArticles.length} planned next</span>
              </div>
              <a class="start-here-card__cta" href={guide.href}>
                Open the guide
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <MailingListCTA />
</BaseLayout>

<style lang="scss">
  .start-here-grid {
    padding-top: clamp(2.75rem, 5vw, 4rem);
  }

  .start-here-grid__heading {
    margin: 0 0 1.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .start-here-grid__cards {
    display: grid;
    gap: 1rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .start-here-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-pink);
    border-radius: 10px;
    background:
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--color-pink) 5%, var(--color-surface)) 0%,
        var(--color-surface) 58%
      ),
      var(--color-surface);
    box-shadow: 0 18px 40px rgba(15, 15, 15, 0.06);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;

    &:hover {
      transform: translateY(-4px);
      box-shadow: 0 22px 44px rgba(232, 0, 106, 0.12);
      border-color: rgba(232, 0, 106, 0.26);
    }
  }

  .start-here-card__title {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.2rem;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .start-here-card__body {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .start-here-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .start-here-card__cta {
    margin-top: auto;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-pink);
  }
</style>
