---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import MailingListCTA from "../../components/MailingListCTA.astro";
import { audienceGuides } from "../../data/audienceGuides";
import { getGuideIcon } from "../../utils/contentIcons";
---

<BaseLayout
  pageTitle="Guides — Sourcier"
  description="Choose a practical, article-led guide for transitioning into tech, growing as an engineer, or improving engineering practice on your team."
>
  <PageHero
    kicker="Start here"
    title="Choose the guide that matches where you are now"
    tone="secondary"
    subtitle="Guides are the free, article-led way to get oriented. Start with the one that fits your situation, read the published pieces, and see what is planned next. If you want structured teaching with included 1:1 support, that is what courses are for."
  />

  <section
    class="section guides-grid flow-section flow-section--loose"
    aria-labelledby="guides-grid-heading"
  >
    <div class="container is-max-desktop">
      <p class="section-label">Guides</p>
      <h2 class="guides-grid__heading" id="guides-grid-heading">
        Three practical reading guides into the site
      </h2>
      <p class="guides-grid__intro">
        Each guide groups the published articles for one audience and shows the
        next topics still to come, so you can decide what to read first before
        you commit to anything more structured.
      </p>
      <div class="guides-grid__cards">
        {
          audienceGuides.map((guide) => (
            <article class="guide-card">
              <div class="guide-card__header">
                <span
                  class="guide-card__icon"
                  aria-hidden="true"
                  set:html={getGuideIcon(guide.slug, 18)}
                />
                <div class="guide-card__heading-group">
                  <h3 class="guide-card__title">{guide.title}</h3>
                </div>
              </div>
              <p class="guide-card__body">{guide.summary}</p>
              <div class="guide-card__meta" aria-label="Guide coverage">
                <span>{guide.currentPostIds.length} published now</span>
                <span>{guide.plannedArticles.length} planned next</span>
              </div>
              <a class="guide-card__cta" href={guide.href}>
                Open the guide
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <MailingListCTA />
</BaseLayout>

<style lang="scss">
  .guides-grid {
    padding-top: 0;
    padding-bottom: 0;
  }

  .guides-grid__heading {
    margin: 0 0 1.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.05;
    color: var(--text-primary);
  }

  .guides-grid__intro {
    max-width: 64ch;
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .guides-grid__cards {
    display: grid;
    gap: 1rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .guide-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100%;
    padding: 1.55rem 1.5rem 1.45rem;
    border: 1px solid
      color-mix(in srgb, var(--accent-primary) 10%, var(--border-subtle));
    border-radius: var(--radius-panel);
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--accent-primary) 10%, transparent) 0%,
        transparent 42%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--surface-elevated) 95%, white) 0%,
        var(--surface-elevated) 100%
      ),
      var(--surface-elevated);
    box-shadow: 0 14px 30px rgba(var(--shadow-rgb), 0.05);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 1.5rem;
      width: 3.6rem;
      height: 2px;
      background: linear-gradient(
        90deg,
        var(--accent-primary) 0%,
        transparent 100%
      );
      pointer-events: none;
    }

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 34px rgba(var(--accent-primary-rgb), 0.1);
      border-color: rgba(var(--accent-primary-rgb), 0.26);
    }
  }

  .guide-card__title {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.2rem;
    line-height: 1.1;
    color: var(--text-primary);
  }

  .guide-card__header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .guide-card__heading-group {
    display: grid;
  }

  .guide-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-pill);
    background: color-mix(
      in srgb,
      var(--surface-page) 82%,
      var(--accent-primary) 18%
    );
    color: var(--accent-primary);
    flex-shrink: 0;

    :global(svg) {
      display: block;
    }
  }

  .guide-card__body {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .guide-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-family: "Barlow", sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--text-muted);
  }

  .guide-card__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    padding-block: 0.75rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent-primary);
  }
</style>
