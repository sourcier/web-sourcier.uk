---
import { getCollection } from "astro:content";
import { isPublished } from "../utils/drafts";
import readingTime from "reading-time";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import MailingListCTA from "../components/MailingListCTA.astro";
import Testimonials from "../components/Testimonials.astro";
import CourseLaunchSection from "../components/CourseLaunchSection.astro";
import { audienceGuides } from "../data/audienceGuides";

const allPosts = (await getCollection("posts"))
  .filter(isPublished)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const GRID_SIZE = 6;
const placeholderCount = Math.max(0, GRID_SIZE - allPosts.length);
---

<BaseLayout
  pageTitle="Sourcier — Practical software engineering guidance"
  description="Practical software engineering guidance for people transitioning into tech, engineers growing in confidence, and teams improving how they build software."
>
  <section class="hero-intro">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column">
          <span class="hero-kicker"
            >Sourcier &middot; Mentoring, career growth, and better software
            delivery</span
          >
          <h1 class="hero-title">Practical software engineering guidance</h1>
          <p class="hero-bio">
            I help people transition into tech, engineers grow with confidence,
            and teams improve how they build software. Writing about
            <span class="hero-cycle" aria-live="polite" aria-atomic="true"
              ><span class="hero-cycle__term" id="heroCycleTerm"
                >Breaking into Tech</span
              ></span
            >
          </p>
          <div class="buttons">
            <a href="/guides" class="button is-primary is-medium"
              >Choose a guide</a
            >
            <a href="/contact" class="button is-light is-medium">Get guidance</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="section audience-paths"
    id="audience-paths"
    aria-labelledby="audience-paths-heading"
  >
    <div class="container is-max-desktop">
      <p class="section-label section-label--secondary">Who this site is for</p>
      <h2 class="audience-paths__heading" id="audience-paths-heading">
        Choose the guide that matches where you are now
      </h2>
      <div class="audience-paths__grid">
        {
          audienceGuides.map((guide) => (
            <article class="audience-card">
              <h3 class="audience-card__title">{guide.title}</h3>
              <p class="audience-card__body">{guide.summary}</p>
              <a class="audience-card__primary" href={guide.href}>
                Open the guide
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-label="Recent Posts">
    <div class="container is-max-desktop">
      <p class="section-label section-label--secondary">Latest writing</p>
      <div
        class="fixed-grid has-1-cols-mobile has-3-cols-tablet has-3-cols-desktop"
      >
        <div class="grid">
          {
            allPosts.map((post) => (
              <div class="cell">
                <BlogPost
                  title={post.data.title}
                  subTitle={post.data.subTitle}
                  description={post.data.description}
                  url={`/blog/${post.id}`}
                  cover={post.data.cover}
                  pubDate={post.data.pubDate}
                  draft={post.data.draft}
                  readingTime={readingTime(post.body ?? "").text}
                />
              </div>
            ))
          }
          {
            Array.from({ length: placeholderCount }).map(() => (
              <div class="cell">
                <div
                  class="card card__blog card__blog--placeholder"
                  aria-hidden="true"
                >
                  <div class="card__blog--placeholder-inner">
                    <span class="card__blog--placeholder-label">
                      More posts coming soon
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CourseLaunchSection />

  <section
    class="section community-offer"
    aria-labelledby="community-offer-heading"
  >
    <div class="container is-max-desktop">
      <div class="community-offer__grid">
        <div class="community-offer__main page-panel page-panel--secondary">
          <div class="community-offer__intro">
            <p class="section-label section-label--secondary">Community</p>
            <div class="community-offer__chips" aria-label="Offer details">
              <span class="community-offer__chip">1 day/month</span>
              <span class="community-offer__chip">Free</span>
              <span class="community-offer__chip">Clearly scoped</span>
            </div>
            <h2 class="community-offer__heading" id="community-offer-heading">
              One free day each month for a charity
            </h2>
            <p class="community-offer__body">
              The charity sector is close to my heart, so I set aside one day
              each month for a charity or community organisation that could use
              practical help moving a digital problem or piece of work forward.
            </p>
          </div>
          <div class="community-offer__footer">
            <div class="community-offer__actions">
              <a href="/charity-support" class="button is-ink is-medium">
                See how it works
              </a>
              <a
                href="/contact?reason=charity-support#contact-form"
                class="community-offer__link"
              >
                Ask if it is a fit
              </a>
            </div>
          </div>
        </div>

        <aside class="community-offer__aside page-panel page-panel--secondary">
          <p class="community-offer__aside-label">What a day can cover</p>
          <ul class="community-offer__list" role="list">
            <li>Website, form, and accessibility improvements</li>
            <li>Small workflow fixes or lightweight automation</li>
            <li>Advice on scope, priorities, and next steps</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <Testimonials />
  <MailingListCTA />
</BaseLayout>

<style lang="scss">
  .audience-paths {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 1rem;
  }

  .audience-paths__heading {
    margin: 0 0 1.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.05;
    color: var(--color-ink);
    text-transform: uppercase;
  }

  .audience-paths__grid {
    display: grid;
    gap: 1rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .audience-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-secondary);
    border-radius: var(--radius-panel);
    background:
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--color-secondary) 9%, var(--color-surface)) 0%,
        var(--color-surface) 58%
      ),
      var(--color-surface);
    box-shadow: var(--shadow-panel);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-secondary) 7%, transparent) 0%,
        transparent 42%
      );
      pointer-events: none;
    }

    &:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
      border-color: color-mix(in srgb, var(--color-secondary) 22%, transparent);
    }
  }

  .audience-card__title {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.2rem;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .audience-card__body {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .audience-card__primary {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .audience-card__primary {
    color: var(--color-secondary);
  }

  .community-offer {
    padding-top: clamp(1rem, 2vw, 1.5rem);
    padding-bottom: clamp(1.6rem, 3.5vw, 2.8rem);
  }

  .community-offer__grid {
    display: grid;
    gap: 1rem;

    @media (min-width: 960px) {
      grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.85fr);
    }
  }

  .community-offer__main,
  .community-offer__aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .community-offer__intro {
    display: grid;
    gap: 0.95rem;
  }

  .community-offer__heading {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .community-offer__body {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .community-offer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 34rem;
  }

  .community-offer__chip,
  .community-offer__aside-label {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .community-offer__chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.28rem 0.62rem;
    border-radius: 999px;
    border: 1px solid
      color-mix(in srgb, var(--color-secondary) 16%, transparent);
    background: color-mix(in srgb, var(--color-secondary) 5%, transparent);
    color: var(--color-secondary);
  }

  .community-offer__aside-label {
    margin: 0;
    color: var(--color-secondary);
  }

  .community-offer__footer {
    display: grid;
    gap: 0.95rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 78%, transparent);
  }

  .community-offer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;

    @media (max-width: 639px) {
      align-items: stretch;

      > .button {
        width: 100%;
        justify-content: center;
      }
    }
  }

  .community-offer__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.55rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-secondary);
    transition:
      color 0.15s ease,
      transform 0.15s ease;

    &:hover {
      color: var(--color-pink);
      transform: translateY(-1px);
    }
  }

  .community-offer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .community-offer__list li {
    position: relative;
    padding-left: 1rem;
    color: var(--color-muted);
    line-height: 1.65;

    &::before {
      content: "";
      position: absolute;
      top: 0.68rem;
      left: 0;
      width: 0.38rem;
      height: 0.38rem;
      border-radius: 999px;
      background: var(--color-secondary);
      transform: translateY(-50%);
    }
  }

  .card__blog--placeholder {
    pointer-events: none;
    border: 2px dashed var(--color-border);
    border-top: 2px dashed var(--color-border);
    background: transparent;
    box-shadow: none;

    &-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
      padding: 2rem 1.5rem;
    }

    &-label {
      font-family: "Barlow Condensed", sans-serif;
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-border);
    }
  }
</style>

<script>
  const terms = [
    "Breaking into Tech",
    "Career Growth",
    "Engineering Practice",
    "Mentoring Engineers",
    "Shipping Better Software",
  ];

  const el = document.getElementById("heroCycleTerm");
  if (el && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let current = 0;

    setInterval(() => {
      current = (current + 1) % terms.length;

      el.classList.add("is-leaving");

      setTimeout(() => {
        el.classList.remove("is-leaving");
        el.classList.add("is-entering");
        el.textContent = terms[current];

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            el.classList.remove("is-entering");
          });
        });
      }, 250);
    }, 2800);
  }
</script>
