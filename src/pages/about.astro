---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CareerTimeline from "../components/CareerTimeline.astro";
import MailingListCTA from "../components/MailingListCTA.astro";
import {
  faHtml5,
  faCss3Alt,
  faJs,
  faTypescript,
  faReact,
  faNodeJs,
  faGitAlt,
  faDocker,
  faAws,
  faMicrosoft,
  faPostgresql,
} from "@fortawesome/free-brands-svg-icons";
import {
  faPaperPlane,
  faRectangleList,
  faHexagonNodes,
  faCloud,
} from "@fortawesome/free-solid-svg-icons";
import { faIcon } from "../utils/icons";

const frontendStack = [
  { label: "CSS / Sass", icon: faIcon(faCss3Alt, { size: 18 }) },
  { label: "HTML", icon: faIcon(faHtml5, { size: 18 }) },
  { label: "JavaScript", icon: faIcon(faJs, { size: 18 }) },
  { label: "TypeScript", icon: faIcon(faTypescript, { size: 18 }) },
];

const frameworksStack = [
  { label: "Astro", icon: faIcon(faPaperPlane, { size: 18 }) },
  { label: "React", icon: faIcon(faReact, { size: 18 }) },
];

const backendStack = [
  { label: "GraphQL", icon: faIcon(faHexagonNodes, { size: 18 }) },
  { label: "Node.js", icon: faIcon(faNodeJs, { size: 18 }) },
  { label: "PostgreSQL", icon: faIcon(faPostgresql, { size: 18 }) },
  { label: "REST APIs", icon: faIcon(faRectangleList, { size: 18 }) },
];

const toolingStack = [
  { label: "AWS", icon: faIcon(faAws, { size: 18 }) },
  { label: "Azure", icon: faIcon(faMicrosoft, { size: 18 }) },
  { label: "Docker", icon: faIcon(faDocker, { size: 18 }) },
  { label: "Git", icon: faIcon(faGitAlt, { size: 18 }) },
  { label: "Netlify", icon: faIcon(faCloud, { size: 18 }) },
];

const pageTitle = "About — Roger Rajaratnam";
---

<BaseLayout
  pageTitle={pageTitle}
  description="Helping career switchers, growing engineers, and teams build better software engineering practice."
>
  <PageHero
    kicker="About"
    title="Roger Rajaratnam"
    subtitle="Helping people move into tech, engineers grow, and teams improve how they build software"
  />

  <!-- Stats bar -->
  <div class="about-stats">
    <div class="container is-max-desktop">
      <ul class="about-stats__list" role="list">
        <li class="about-stats__item">
          <span class="about-stats__label">Years in software</span>
          <span class="about-stats__value">20+</span>
        </li>
        <li class="about-stats__item">
          <span class="about-stats__label">Current domain</span>
          <span class="about-stats__value">Fintech</span>
        </li>
        <li class="about-stats__item">
          <span class="about-stats__label">Teaching experience</span>
          <span class="about-stats__value">Bootcamps</span>
        </li>
        <li class="about-stats__item">
          <span class="about-stats__label">Career focus</span>
          <span class="about-stats__value">Mentoring</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bio sections -->
  <section class="section about-bio" aria-labelledby="bio-heading">
    <div class="container is-max-desktop">
      <div class="about-bio__grid">
        <!-- Left: labelled narrative blocks -->
        <div class="about-bio__main">
          <div class="about-bio__block">
            <h2 class="about-bio__kicker">How I work</h2>
            <p class="about-bio__text">
              I am a software engineer based in London with more than 20 years
              of experience across product engineering, delivery, mentoring, and
              team leadership. The thread that runs through all of it is
              practical improvement: helping people and teams get better at
              building software without adding unnecessary ceremony.
            </p>
          </div>

          <div class="about-bio__block" id="career-support">
            <h2 class="about-bio__kicker">
              For people transitioning into tech
            </h2>
            <p class="about-bio__text">
              I teach the parts that often stay fuzzy when you are new: how the
              web stack fits together, how to think about trade-offs, how to go
              from tutorials to real projects, and how to build enough context
              to make better decisions. My bootcamp teaching experience made me
              care deeply about turning complex engineering work into something
              clear and usable.
            </p>
          </div>

          <div class="about-bio__block" id="career-growth-support">
            <h2 class="about-bio__kicker">
              For engineers growing in confidence
            </h2>
            <p class="about-bio__text">
              A lot of career progression comes down to better habits rather
              than flashy knowledge: debugging clearly, writing maintainable
              code, communicating trade-offs, and learning how to own outcomes.
              I enjoy helping engineers make that shift from delivering tasks to
              growing into trusted contributors.
            </p>
          </div>

          <div class="about-bio__block" id="team-standards-support">
            <h2 class="about-bio__kicker">
              For teams improving engineering practice
            </h2>
            <p class="about-bio__text">
              Most teams do not need more process. They need clearer
              expectations, healthier delivery habits, better testing, more
              thoughtful mentoring, and pragmatic technical direction. I work
              best where teams want to raise the bar without slowing everything
              down.
            </p>
          </div>
        </div>

        <!-- Right: sidebar cards -->
        <aside class="about-bio__sidebar" aria-label="Quick facts">
          <div class="about-sidebar-card about-sidebar-card--highlight">
            <p class="about-sidebar-card__label">Currently</p>
            <p class="about-sidebar-card__title">Staff Engineer</p>
            <p class="about-sidebar-card__sub">NewDay · London</p>
          </div>

          <div class="about-sidebar-card">
            <p class="about-sidebar-card__label">Teaching background</p>
            <p class="about-sidebar-card__title">
              Full-Stack Bootcamp Instructor
            </p>
            <p class="about-sidebar-card__sub">The Jump Digital School</p>
          </div>

          <div class="about-sidebar-card">
            <p class="about-sidebar-card__label">Who I help</p>
            <ul class="about-tag-list" role="list">
              <li>Career changers</li>
              <li>Engineers building confidence</li>
              <li>Engineers taking on more ownership</li>
              <li>Product teams</li>
              <li>Growing engineering teams</li>
            </ul>
          </div>

          <div class="about-sidebar-card">
            <p class="about-sidebar-card__label">Focus areas</p>
            <ul class="about-tag-list" role="list">
              <li>Mentoring and coaching</li>
              <li>Engineering practice</li>
              <li>Full-stack delivery</li>
              <li>Testing and automation</li>
              <li>Developer experience</li>
              <li>Pragmatic team leadership</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Pullquote -->
  <div class="about-pullquote" aria-hidden="false">
    <div class="container is-max-desktop">
      <blockquote class="about-pullquote__inner">
        <p>
          I write for people getting into tech, engineers figuring out their
          next level, and teams that want practical engineering practice rather
          than process theatre.
        </p>
      </blockquote>
    </div>
  </div>

  <!-- Tech stack section -->
  <section class="section about-stack" aria-labelledby="stack-heading">
    <div class="container is-max-desktop">
      <p class="section-label" id="stack-heading">Tech stack</p>
      <div class="about-stack__grid">
        <div class="about-stack__group">
          <h2 class="about-stack__category">Frontend</h2>
          <ul class="about-stack__list" role="list">
            {
              frontendStack.map(({ label, icon }) => (
                <li>
                  <span class="stack-icon" set:html={icon} />
                  {label}
                </li>
              ))
            }
          </ul>
          <h3 class="about-stack__subcategory">Frameworks</h3>
          <ul class="about-stack__list" role="list">
            {
              frameworksStack.map(({ label, icon }) => (
                <li>
                  <span class="stack-icon" set:html={icon} />
                  {label}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="about-stack__group">
          <h2 class="about-stack__category">Backend</h2>
          <ul class="about-stack__list" role="list">
            {
              backendStack.map(({ label, icon }) => (
                <li>
                  <span class="stack-icon" set:html={icon} />
                  {label}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="about-stack__group">
          <h2 class="about-stack__category">Tooling &amp; Infrastructure</h2>
          <ul class="about-stack__list" role="list">
            {
              toolingStack.map(({ label, icon }) => (
                <li>
                  <span class="stack-icon" set:html={icon} />
                  {label}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CareerTimeline />
  <MailingListCTA />
</BaseLayout>

<style lang="scss">
  /* ── Stats bar ─────────────────────────────────────────────── */
  .about-stats {
    padding: clamp(2.75rem, 5vw, 4rem) 1.5rem 0;
    margin-top: 0;
  }

  .about-stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;

    @media (min-width: 640px) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .about-stats__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: clamp(7.25rem, 14vw, 8.25rem);
    padding: 1.5rem 1.25rem 1.25rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-pink);
    border-radius: 10px;
    background:
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--color-pink) 5%, var(--color-surface)) 0%,
        var(--color-surface) 58%
      ),
      var(--color-surface);
    position: relative;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;

    &:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(232, 0, 106, 0.12);
    }
  }

  .about-stats__value {
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    line-height: 1;
  }

  .about-stats__label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  /* ── Bio grid ──────────────────────────────────────────────── */
  .about-bio {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .about-bio__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;

    @media (min-width: 768px) {
      grid-template-columns: 1fr 280px;
      gap: 4rem;
      align-items: start;
    }
  }

  .about-bio__main {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .about-bio__block {
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-pink);
  }

  .about-bio__kicker {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-pink);
    margin-bottom: 0.75rem;
  }

  .about-bio__text {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-ink);
    margin: 0;
  }

  /* ── Sidebar cards ─────────────────────────────────────────── */
  .about-bio__sidebar {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
  }

  .about-sidebar-card {
    background-color: var(--color-surface);
    padding: 1.25rem 1.5rem;

    &--highlight {
      background-color: var(--color-ink);

      .about-sidebar-card__label {
        color: rgba(255, 255, 255, 0.65);
      }

      .about-sidebar-card__title {
        color: #ffffff;
      }

      .about-sidebar-card__sub {
        color: rgba(255, 255, 255, 0.7);
      }
    }
  }

  :global([data-theme="dark"]) .about-sidebar-card--highlight {
    background-color: var(--color-pink);
  }

  .about-sidebar-card__label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-pink);
    margin-bottom: 0.5rem;
  }

  .about-sidebar-card__title {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .about-sidebar-card__sub {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .about-tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    li {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--color-ink);
      padding-left: 0.875rem;
      position: relative;

      &::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.45em;
        width: 5px;
        height: 5px;
        background-color: var(--color-pink);
      }
    }
  }

  /* ── Tech stack section ────────────────────────────────────── */
  .about-stack {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .about-stack__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;

    @media (min-width: 640px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-stack__group {
    padding: 1.75rem 1.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-pink);
    border-radius: 6px;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;

    &:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(232, 0, 106, 0.12);
    }
  }

  .about-stack__category {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-pink);
    margin-bottom: 1.25rem;
  }

  .about-stack__subcategory {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }

  .about-stack__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;

    li {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--color-ink);
    }
  }

  .stack-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-pink);

    svg {
      display: block;
    }
  }

  /* ── Pullquote ─────────────────────────────────────────────── */
  .about-pullquote {
    padding: 4rem 1.5rem;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .about-pullquote__inner {
    margin: 0;
    padding: 0;
    position: relative;
    padding-left: 2rem;

    &::before {
      content: "\201C";
      position: absolute;
      left: 0;
      top: -0.1em;
      font-family: "Barlow Condensed", sans-serif;
      font-size: 4rem;
      font-weight: 800;
      line-height: 1;
      color: var(--color-pink);
    }

    p {
      font-family: "Barlow Condensed", sans-serif;
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 700;
      line-height: 1.4;
      color: var(--color-ink);
      text-transform: uppercase;
      letter-spacing: 0.01em;
      margin: 0;
    }
  }
</style>
