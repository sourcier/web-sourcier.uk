---
import { getCollection } from "astro:content";
import { isPublished } from "../../utils/drafts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import MailingListCTA from "../../components/MailingListCTA.astro";
import BlogGrid from "../../components/BlogGrid.astro";
import BlogTagCloud from "../../components/BlogTagCloud.astro";
import { audienceGuides } from "../../data/audienceGuides";

const PAGE_SIZE = 9;

const allPosts = (await getCollection("posts"))
  .filter(isPublished)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
const posts = allPosts.slice(0, PAGE_SIZE);
const nextUrl = totalPages > 1 ? "/blog/page/2" : null;
const totalTags = new Set(allPosts.flatMap((post) => post.data.tags)).size;
---

<BaseLayout
  pageTitle="Blog — Sourcier"
  description="Practical writing for people transitioning into tech, engineers growing in confidence, and teams improving engineering practice."
>
  <PageHero
    kicker="Writing"
    title="Blog"
    subtitle="Practical writing for career switchers, engineers building confidence, and teams improving how they build software."
  />

  <div class="blog-intro flow-section flow-section--loose">
    <div class="container is-max-desktop">
      <div class="blog-intro__panel page-panel">
        <div class="blog-intro__copy">
          <p class="blog-intro__eyebrow">What you will find here</p>
          <div class="blog-intro__quote">
            <p>
              This blog turns real software engineering work into practical
              guidance for people moving into tech, engineers growing in
              confidence, and teams improving engineering practice.
            </p>
          </div>
        </div>
        <ul class="blog-intro__stats" role="list">
          <li class="blog-intro__stat">
            <span class="blog-intro__stat-label">Published</span>
            <span class="blog-intro__stat-value">{allPosts.length}</span>
          </li>
          <li class="blog-intro__stat">
            <span class="blog-intro__stat-label">Topics</span>
            <span class="blog-intro__stat-value">{totalTags}</span>
          </li>
          <li class="blog-intro__stat">
            <span class="blog-intro__stat-label">Guides</span>
            <span class="blog-intro__stat-value">{audienceGuides.length}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <section class="blog-paths flow-section" aria-labelledby="blog-paths-heading">
    <div class="container is-max-desktop">
      <p class="section-label">Start here</p>
      <h2 class="blog-paths__heading" id="blog-paths-heading">
        Pick the guide that fits where you are now
      </h2>
      <div class="blog-paths__grid">
        {
          audienceGuides.map((guide) => (
            <article class="blog-path-card">
              <p class="blog-path-card__eyebrow">Guide</p>
              <h3 class="blog-path-card__title">{guide.title}</h3>
              <p class="blog-path-card__body">{guide.summary}</p>
              <div class="blog-path-card__meta" aria-label="Guide coverage">
                <span>{guide.currentPostIds.length} published now</span>
                <span>{guide.plannedArticles.length} planned next</span>
              </div>
              <a class="blog-path-card__cta" href={guide.href}>
                Open the guide
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <BlogGrid
    posts={posts}
    currentPage={1}
    totalPages={totalPages}
    prevUrl={null}
    nextUrl={nextUrl}
    sectionLabel="Latest posts"
    sectionTitle="Recent articles from the blog"
    sectionDescription="Newest practical articles, notes, and implementation write-ups from across the site."
  />

  <BlogTagCloud />

  <MailingListCTA />
</BaseLayout>

<style lang="scss">
  .blog-intro {
    padding: 0 1.5rem;
    margin-bottom: 0;
  }

  .blog-intro__panel {
    display: grid;
    gap: 1.5rem;

    @media (min-width: 768px) {
      grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 0.9fr);
      gap: 2rem;
      align-items: center;
    }
  }

  .blog-intro__copy {
    display: grid;
    gap: 0.75rem;
  }

  .blog-intro__eyebrow {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .blog-paths {
    padding: 0 1.5rem;
  }

  .blog-paths__heading {
    margin: 0 0 1.5rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .blog-paths__grid {
    display: grid;
    gap: 1rem;

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .blog-path-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-secondary);
    border-radius: var(--radius-panel);
    background:
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--color-secondary) 12%, transparent) 0%,
        transparent 32%
      ),
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--color-pink) 4%, var(--color-surface)) 0%,
        var(--color-surface) 58%
      ),
      var(--color-surface);
    box-shadow: var(--shadow-panel);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;

    &:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
      border-color: rgba(41, 92, 69, 0.24);
    }
  }

  .blog-path-card__eyebrow {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .blog-path-card__title {
    margin: 0;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 1.15rem;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .blog-path-card__body {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .blog-path-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);

    span {
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-secondary) 8%, transparent);
    }
  }

  .blog-path-card__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-secondary);
    text-decoration: none;
  }

  .blog-intro__quote {
    margin: 0;
    padding-left: clamp(1.25rem, 3vw, 1.75rem);
    border-left: 3px solid var(--color-pink);
    position: relative;

    p {
      font-size: clamp(1.02rem, 1.9vw, 1.16rem);
      font-weight: 500;
      line-height: 1.72;
      color: var(--color-ink);
      margin: 0;
    }
  }

  .blog-intro__stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .blog-intro__stat {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid
      color-mix(in srgb, var(--color-secondary) 18%, transparent);
    border-radius: 14px;
    background: color-mix(
      in srgb,
      var(--color-secondary) 7%,
      var(--color-surface)
    );
  }

  .blog-intro__stat-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  .blog-intro__stat-value {
    font-family: "Barlow Condensed", sans-serif;
    font-size: clamp(1.55rem, 4vw, 2.15rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-ink);
  }
</style>
